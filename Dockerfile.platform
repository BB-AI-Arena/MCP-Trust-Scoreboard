FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml README.md VERSION ./
COPY src ./src
RUN pip install --no-cache-dir '.[postgres]'

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
LABEL org.opencontainers.image.title="Agent Trust Platform" org.opencontainers.image.version="2.0.0-alpha.1"
EXPOSE 8080
CMD ["uvicorn", "agent_trust.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
