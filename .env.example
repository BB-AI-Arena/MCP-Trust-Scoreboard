# =============================================================================
# Agent Trust Platform — Environment Variables
#
# Reference only. Fresh installs: python3 scripts/configure_local.py
# Preserve existing database credentials on upgrades. Never commit credentials.
# Provider keys alone cannot enable hosted analysis; explicit opt-in is required.
# =============================================================================

# ---------------------------------------------------------------------------
# Optional legacy AI Analysis — Google Gemini (live compatibility unverified)
# Get your key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Domain Threat Intelligence — AbuseIPDB
# Get your key: https://www.abuseipdb.com/register
# ---------------------------------------------------------------------------
ABUSEIPDB_API_KEY=

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# Names retained for upgrade compatibility. Fill with existing credentials or
# let configure_local.py generate credentials for a fresh database.
# ---------------------------------------------------------------------------
POSTGRES_USER=koi
POSTGRES_PASSWORD=
POSTGRES_DB=koi_security
# Compose constructs DATABASE_URL from POSTGRES_*; no separate override needed.

# ---------------------------------------------------------------------------
# Cache / Queue — Redis
# Points to the redis service defined in docker-compose.yml.
# Legacy compatibility only; modular results/jobs are stored in PostgreSQL.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Legacy alias only; setting this does NOT authenticate legacy routes.
SECRET_KEY=

# ---------------------------------------------------------------------------
# Namespaced Agent Trust Platform API (required by the new API service)
# ---------------------------------------------------------------------------
# Required random token, at least 32 characters. No working demo credential.
AGENT_TRUST_API_TOKEN=
AGENT_TRUST_AUTH_MODE=token
AGENT_TRUST_WORKSPACE_ID=local
AGENT_TRUST_API_SCOPES=read,write,assess
AGENT_TRUST_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGENT_TRUST_HOSTED_ANALYSIS=false

# SCAN_MODE: 'async' (default) uses the worker queue via Redis.
#            'sync' runs scans inline — useful for debugging without a worker.
SCAN_MODE=async

# Legacy manifest collector safety; keep false unless a scoped local fixture is used.
ALLOW_PRIVATE_COLLECTOR_TARGETS=false
