# =============================================================================
# Koi Security Extensions — Environment Variables
#
# Copy this file to .env and fill in values before running docker compose.
# Both API keys are optional — apps degrade gracefully when missing.
# =============================================================================

# ---------------------------------------------------------------------------
# AI Analysis — Google Gemini 2.0 Flash
# Get your key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Domain Threat Intelligence — AbuseIPDB
# Get your key: https://www.abuseipdb.com/register
# ---------------------------------------------------------------------------
ABUSEIPDB_API_KEY=

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# These defaults work out of the box with docker compose.
# Change in production — use AWS Secrets Manager for enterprise deployments.
# ---------------------------------------------------------------------------
POSTGRES_USER=koi
POSTGRES_PASSWORD=koi_dev_password
POSTGRES_DB=koi_security
DATABASE_URL=postgresql://koi:koi_dev_password@postgres:5432/koi_security

# ---------------------------------------------------------------------------
# Cache / Queue — Redis
# Points to the redis service defined in docker-compose.yml.
# In production: replace with your ElastiCache endpoint.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# SECRET_KEY: used for JWT signing. Set to a random string in production.
SECRET_KEY=dev-secret-change-in-production

# SCAN_MODE: 'async' (default) uses the worker queue via Redis.
#            'sync' runs scans inline — useful for debugging without a worker.
SCAN_MODE=async
